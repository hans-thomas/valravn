{
    "name": "hans-thomas/valravn",
    "description": "valravn is a set of predefined classes for laravel.",
    "keywords": [
        "laravel",
        "api",
        "starter-kit",
        "restful-api",
        "development-tools"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "mortazavi",
            "email": "s.mohammad027@live.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10|^11|^12",
        "mavinoo/laravel-batch": "^2.3"
    },
    "require-dev": {
        "orchestra/testbench": "^8|^9",
        "nunomaduro/collision": "^7|^8",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Hans\\Valravn\\": "src/"
        },
        "files": [
            "./src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Hans\\Valravn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
              "Hans\\Valravn\\ValravnServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "complete-check": [
            "@analys",
            "@test"
        ],
        "testbench": "./vendor/bin/testbench",
        "test": "./vendor/bin/phpunit",
        "test:testbench": "./vendor/bin/testbench package:test",
        "test:coverage": "./vendor/bin/phpunit --coverage-clover ./coverage.xml",
        "analys": "./vendor/bin/phpstan analys src --level 1 --memory-limit=512M"
    }
}
